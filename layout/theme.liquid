<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {%- liquid
    assign seo_title = page_title
    unless page_title contains shop.name
      assign seo_title = page_title | append: ' | ' | append: shop.name
    endunless
    assign seo_description = page_description | default: shop.description
  -%}

  <title>{{ seo_title | escape }}</title>
  <meta name="description" content="{{ seo_description | escape }}">

  {% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}

  {%- if template.name == '404' or template.name == 'search' or template.name == 'cart' -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:description" content="{{ seo_description | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="en_GB">
  {%- if page_image -%}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
  {%- else -%}
    <meta property="og:image" content="{{ 'hero-ink.png' | asset_url }}">
  {%- endif -%}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  <meta name="twitter:description" content="{{ seo_description | escape }}">
  {%- if page_image -%}
    <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta name="twitter:image" content="{{ 'hero-ink.png' | asset_url }}">
  {%- endif -%}

  <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">

  <meta name="theme-color" content="#0EA5E9">
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ shop.url }}#business",
    "name": {{ shop.name | json }},
    "description": {{ shop.description | json }},
    "url": {{ shop.url | json }},
    "image": {{ 'logo.png' | asset_url | json }},
    "logo": {{ 'logo.png' | asset_url | json }},
    {% if settings.email_address != blank %}"email": {{ settings.email_address | json }},{% endif %}
    {%- liquid
      assign same_as = ''
      if settings.social_facebook != blank
        assign same_as = same_as | append: settings.social_facebook | append: '|'
      endif
      if settings.social_instagram != blank
        assign same_as = same_as | append: settings.social_instagram | append: '|'
      endif
      if settings.social_twitter != blank
        assign same_as = same_as | append: settings.social_twitter | append: '|'
      endif
    -%}
    {%- if same_as != blank -%}
    "sameAs": {{ same_as | split: '|' | json }},
    {%- endif -%}
    {% if settings.opening_hours != blank %}"openingHours": {{ settings.opening_hours | json }},{% endif %}
    "areaServed": "GB",
    "currenciesAccepted": "GBP",
    "priceRange": "££"
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "{{ shop.url }}#website",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "publisher": { "@id": "{{ shop.url }}#business" }
  }
  </script>

  {%- if template.name == 'page' and page.title != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": "{{ shop.url }}{{ page.url }}" }
    ]
  }
  </script>
  {%- endif -%}
</head>
<body class="template-{{ template.name }}">

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
