{%- assign standard_product = all_products['backlit-film-printing'] -%}
{%- assign custom_product = all_products['custom-backlit-film'] -%}
<section
  class="backlit-estimator"
  id="backlit-order"
  data-backlit-estimator
  data-section-id="{{ section.id }}"
  data-ordering-enabled="{{ section.settings.product_active }}"
  data-discounts-active="{{ section.settings.discounts_active }}"
  data-presentment-currency="{{ cart.currency.iso_code | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-root-url="{{ routes.root_url }}"
>
  <div class="container">
    <div class="backlit-estimator__wrapper">
      <div class="backlit-estimator__content">
        <h2 class="backlit-estimator__heading">{{ section.settings.heading }}</h2>
        <p class="backlit-estimator__subheading">{{ section.settings.description }}</p>
        <p><strong>Backlit film printing from £9.99</strong> — graphic only; lightbox and lighting not included.</p>

        <form class="backlit-estimator__form" id="be-purchase-{{ section.id }}" data-be-form>
          <div class="form-field">
            <label for="be-size-{{ section.id }}">Size</label>
            <select id="be-size-{{ section.id }}" class="input" data-be-size>
              <option value="A4" data-width="210" data-height="297">A4 (210 × 297mm) - £9.99</option>
              <option value="A3" data-width="297" data-height="420">A3 (297 × 420mm) - £12.99</option>
              <option value="A2" data-width="420" data-height="594">A2 (420 × 594mm) - £16.99</option>
              <option value="A1" data-width="594" data-height="841">A1 (594 × 841mm) - £24.99</option>
              <option value="A0" data-width="841" data-height="1189">A0 (841 × 1189mm) - £39.99</option>
              <option value="500x700" data-width="500" data-height="700">500 × 700mm - £19.99</option>
              <option value="600x900" data-width="600" data-height="900">600 × 900mm - £27.99</option>
              <option value="600x1200" data-width="600" data-height="1200">600 × 1200mm - £34.99</option>
              <option value="700x1000" data-width="700" data-height="1000">700 × 1000mm - £34.99</option>
              <option value="30x40" data-width="762" data-height="1016">30 × 40in (762 × 1016mm) - £36.99</option>
              <option value="40x60" data-width="1016" data-height="1524">40 × 60in (1016 × 1524mm) - £64.99</option>
              <option value="Custom" data-custom="true">Custom Size</option>
            </select>
          </div>

          <div class="form-row" data-be-custom-dims hidden>
            <div class="form-field">
              <label for="be-width-{{ section.id }}">Width (mm)</label>
              <input type="number" id="be-width-{{ section.id }}" class="input" min="1" step="1" placeholder="e.g. 800" data-be-width>
            </div>
            <div class="form-field">
              <label for="be-height-{{ section.id }}">Height (mm)</label>
              <input type="number" id="be-height-{{ section.id }}" class="input" min="1" step="1" placeholder="e.g. 1000" data-be-height>
            </div>
          </div>

          <div class="form-field">
            <label for="be-finish-{{ section.id }}">Finish</label>
            <select id="be-finish-{{ section.id }}" class="input" data-be-finish>
              <option value="Trimmed to size">Trimmed to size — included</option>
              <option value="Matt lamination">Matt lamination — +£8/m²</option>
              <option value="Gloss lamination">Gloss lamination — +£8/m²</option>
            </select>
          </div>

          <div class="form-field">
            <label for="be-qty-{{ section.id }}">Quantity</label>
            <input type="number" id="be-qty-{{ section.id }}" class="input" min="1" step="1" value="1" data-be-qty>
            <div class="be-qty-discount-note" data-be-qty-note></div>
          </div>

          <div class="form-field">
            <label for="be-artwork-{{ section.id }}">Artwork reference (optional)</label>
            <input type="text" id="be-artwork-{{ section.id }}" class="input" maxlength="120" placeholder="Filename or upload reference" data-be-artwork>
          </div>

        </form>

      </div>

      <div class="backlit-estimator__result-card">
        <h3 class="be-result-title">Pre-discount total</h3>
        <div class="be-result-price" data-be-total aria-live="polite">£9.99</div>
        <div class="be-result-unit" data-be-unit>£9.99 each before discounts</div>

        <div class="be-result-quote" data-be-quote hidden>
          <p>Custom prices over £499.99 and quantities of 50 or more require a trade quote.</p>
          <a href="/pages/contact" class="btn btn--outline">Contact Us</a>
        </div>

        <div class="be-result-action" data-be-action>
          <button type="submit" class="btn btn--primary btn--lg" form="be-purchase-{{ section.id }}" data-be-submit disabled>Add to basket</button>
          <p class="be-result-status" data-be-status role="status" aria-live="polite"></p>
          <a href="/pages/contact">Need help? Request a quote</a>
          <noscript>Please enable JavaScript to calculate a price and order, or contact us for a quote.</noscript>
        </div>

        <ul class="be-features">
          <li>✓ Premium translucent backlit film (Duratrans-style)</li>
          <li>✓ Designed specifically for LED lightboxes</li>
          <li>✓ Vibrant colour when illuminated</li>
          <li>✓ Indoor display use</li>
          <li>✓ Free artwork check</li>
          <li>✓ UK printed</li>
        </ul>
      </div>
    </div>
  </div>

  <script type="application/json" data-be-standard-variants>
    [
      {%- for variant in standard_product.variants -%}
        {"id":{{ variant.id | json }},"available":{{ variant.available | json }},"option1":{{ variant.option1 | json }},"option2":{{ variant.option2 | json }},"price":{{ variant.price | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-be-custom-variants>
    [
      {%- if custom_product.id != blank -%}
      {%- paginate custom_product.variants by 250 -%}
      {%- for variant in custom_product.variants -%}
        {"id":{{ variant.id | json }},"available":{{ variant.available | json }},"option1":{{ variant.option1 | json }},"option2":{{ variant.option2 | json }},"price":{{ variant.price | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
      {%- endpaginate -%}
      {%- endif -%}
    ]
  </script>
</section>

{{ 'backlit-estimator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'backlit-pricing.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'backlit-estimator.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Backlit Estimator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Backlit Graphics"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select a standard size or enter your custom dimensions below to see pricing."
    },
    {
      "type": "checkbox",
      "id": "product_active",
      "label": "Enable native online ordering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "discounts_active",
      "label": "Quantity discounts are configured",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Backlit Estimator"
    }
  ]
}
{% endschema %}