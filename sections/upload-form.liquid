<section class="upload-form">
  <div class="container">
    <div class="upload-form__header">
      <h1 class="upload-form__title">{{ section.settings.heading }}</h1>
      <p class="upload-form__desc">{{ section.settings.description }}</p>
    </div>
    <div class="upload-form__grid">
      <div class="upload-form__info">
        <div class="upload-form__formats">
          <h3>Accepted file formats</h3>
          <div class="upload-form__format-tags">
            <span class="tag">PDF</span>
            <span class="tag">AI</span>
            <span class="tag">EPS</span>
            <span class="tag">SVG</span>
            <span class="tag">PSD</span>
            <span class="tag">TIFF</span>
            <span class="tag">JPG</span>
            <span class="tag">PNG</span>
            <span class="tag">ZIP</span>
          </div>
        </div>
        <div class="upload-form__steps">
          <h3>How it works</h3>
          <ol class="upload-form__steps-list">
            <li>Open The Ink Lab's secure artwork uploader</li>
            <li>Verify your order using its number and checkout email, then select the item</li>
            <li>Add up to 10 artwork files for the selected item or items</li>
            <li>Send files directly to our private production storage</li>
            <li>Keep your upload confirmation reference; we'll check your artwork before printing</li>
          </ol>
        </div>
        <p class="upload-form__help">Need design help? <a href="/pages/contact">Get in touch</a> and we can point you in the right direction.</p>
      </div>
      <div class="upload-form__card">
        <div class="upload-form__form" id="artwork-form">
          <h2>{{ section.settings.button_heading }}</h2>
          <p>{{ section.settings.button_description }}</p>
          {%- if section.settings.upload_app_url != blank -%}
          <a href="{{ section.settings.upload_app_url | escape }}" data-artwork-upload-link class="btn btn--primary btn--lg upload-form__submit-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Open Secure Artwork Uploader
          </a>
          <p class="upload-form__note">The secure uploader opens outside the shop and accepts files up to 2GB each. You will receive a clear confirmation reference when the transfer is complete.</p>
          <p class="upload-form__note">Not ordered yet? Choose “I’m uploading before ordering” in the uploader. These files remain unlinked until you provide the upload reference with your order.</p>
          {%- else -%}
          <p role="status">Online artwork uploads are temporarily unavailable. Please check back shortly or <a href="{{ routes.root_url }}pages/contact">contact us for help</a>.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Upload form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upload Artwork"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Upload files directly to us and link them to your order using your order number and checkout email."
    },
    {
      "type": "text",
      "id": "button_heading",
      "label": "Uploader heading",
      "default": "Ready to send your artwork?"
    },
    {
      "type": "textarea",
      "id": "button_description",
      "label": "Uploader description",
      "default": "Use our secure hosted uploader to send large, print-ready files directly to The Ink Lab."
    },
    {
      "type": "url",
      "id": "upload_app_url",
      "label": "Hosted upload app URL",
      "info": "Use the public, published /upload-artwork URL. Customers must be able to open it without a Replit login. Leave blank until ready."
    }
  ],
  "presets": [
    {
      "name": "Upload form"
    }
  ]
}
{% endschema %}
