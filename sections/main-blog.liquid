<section class="page-hero">
  <div class="container">
    <h1 class="page-hero__title">{{ blog.title }}</h1>
    {% if section.settings.description != blank %}
      <p class="page-hero__desc">{{ section.settings.description }}</p>
    {% endif %}
  </div>
</section>

<section class="blog-listing">
  <div class="container">
    {% paginate blog.articles by 12 %}
      {% if blog.articles.size == 0 %}
        <p class="blog-listing__empty">No posts yet — check back soon.</p>
      {% else %}
        <div class="blog-listing__grid">
          {% for article in blog.articles %}
            <a href="{{ article.url }}" class="blog-card">
              {% if article.image %}
                <div class="blog-card__image">
                  <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | default: article.title }}" loading="lazy" width="600" height="400">
                </div>
              {% endif %}
              <div class="blog-card__content">
                <p class="blog-card__date">{{ article.published_at | date: '%-d %B %Y' }}</p>
                <h2 class="blog-card__title">{{ article.title }}</h2>
                <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
                <span class="blog-card__cta">Read more &rarr;</span>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
      {% if paginate.pages > 1 %}
        <div class="blog-listing__pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">&larr; Newer</a>{% endif %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Older &rarr;</a>{% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog listing",
  "settings": [
    {
      "type": "text",
      "id": "description",
      "label": "Blog description",
      "default": "Guides, tips and ideas from The Ink Lab print team."
    }
  ]
}
{% endschema %}
