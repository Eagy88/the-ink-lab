<section class="backlit-product" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="backlit-product__grid">
      <div class="backlit-product__gallery">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="backlit-product__image">
        {%- else -%}
          <div class="backlit-product__image-placeholder" role="img" aria-label="Illustration of translucent backlit film for an LED lightbox">
            <span class="backlit-product__film-illustration" aria-hidden="true"></span>
            <span>Translucent backlit film for LED lightboxes</span>
          </div>
        {%- endif -%}
      </div>

      <div class="backlit-product__details">
        <h1 class="backlit-product__title">{{ section.settings.title | default: product.title }}</h1>
        
        {%- if section.settings.description != blank -%}
          <p class="backlit-product__description">{{ section.settings.description }}</p>
        {%- endif -%}

        <ul class="backlit-product__features">
          <li>✓ Premium translucent backlit film (Duratrans-style)</li>
          <li>✓ Designed specifically for LED lightboxes</li>
          <li>✓ Free artwork check</li>
          <li>✓ 24–48hr turnaround</li>
          <li>✓ Printed in the UK</li>
        </ul>

        <div class="backlit-product__order-link">
          <h3>Choose your size and finish</h3>
          <p>Use the backlit graphics order calculator for standard or custom dimensions.</p>
          <a href="/pages/backlit-graphics#backlit-order" class="btn btn--primary btn--lg">Price &amp; Order</a>
        </div>

        <div class="backlit-product__artwork-reqs">
          <h3>Artwork Requirements</h3>
          <p><strong>PDF is preferred</strong>, with high-resolution JPG, PNG, TIFF, AI and EPS also accepted.</p>
          <p>For photographs, supply the highest-resolution original available.</p>
          <p>Artwork should be supplied at the ordered dimensions where possible.</p>
          <p>Allow <strong>3mm bleed</strong> around the artwork where required and keep important text/logos at least <strong>10mm from the finished edge</strong>.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{{ 'backlit-product.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Backlit Product",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title",
      "info": "Overrides the default product title if set."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium translucent graphics specifically designed for LED lightboxes and illuminated displays."
    }
  ],
  "presets": [
    {
      "name": "Backlit Product"
    }
  ]
}
{% endschema %}